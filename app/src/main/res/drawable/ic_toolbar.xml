<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar icon for ATAK Tools sheet — radio antenna.

    100×100 viewport gives smooth arc precision (Android VectorDrawable is
    resolution-independent like SVG; paths scale perfectly to any screen density).

    All paths are white (#FFFFFF) with transparent background so ATAK can
    apply its standard toolbar tint and the icon matches the other tool icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!--
      Radio antenna — 100×100 coordinate space.

      Arc math (all arcs radiate UPWARD from the antenna tip at (50, 48)):
        Wave 1: endpoints (39,48)→(61,48), r=12.08 → apex y=43.5  (+4.5 up)
        Wave 2: endpoints (29,48)→(71,48), r=23.35 → apex y=37.3  (+10.7 up)
        Wave 3: endpoints (17,48)→(83,48), r=36.77 → apex y=29.7  (+18.3 up)
      sweep=1 (clockwise in SVG Y-down) produces upward-curving arcs.
    -->

    <!-- ── Antenna mast ───────────────────────────────────────── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M50,88 L50,48" />

    <!-- ── Horizontal base ────────────────────────────────── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M28,88 L72,88" />

    <!-- ── Left support leg ─────────────────────────────── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M28,88 L12,100" />

    <!-- ── Right support leg ────────────────────────────── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M72,88 L88,100" />

    <!-- ── Dot at antenna tip ───────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,48 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!-- ── Radio wave 1 – inner (r=12.08, span=22, apex +4.5 above tip) ── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M39,48 A12.08,12.08 0 0,1 61,48" />

    <!-- ── Radio wave 2 – middle (r=23.35, span=42, apex +10.7 above tip) ── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M29,48 A23.35,23.35 0 0,1 71,48" />

    <!-- ── Radio wave 3 – outer (r=36.77, span=66, apex +18.3 above tip) ── -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M17,48 A36.77,36.77 0 0,1 83,48" />

</vector>
