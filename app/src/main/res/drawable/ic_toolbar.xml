<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar icon for the ATAK Tools sheet.
    No background fill — ATAK applies its own tint color to the white paths.
    Use ic_launcher.xml (dark background + green) for the app/plugin manager icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Antenna mast -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M12,19 L12,11" />

    <!-- Base bar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M8,19 L16,19" />

    <!-- Left leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M8,19 L6,22" />

    <!-- Right leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M16,19 L18,22" />

    <!-- Radio wave 1 (small) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M10,11 A3,3 0 0,1 14,11" />

    <!-- Radio wave 2 (medium) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M8,9 A5,5 0 0,1 16,9" />

    <!-- Radio wave 3 (large) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M6,7 A7,7 0 0,1 18,7" />

    <!-- Dot at tip -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,11 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

</vector>
