<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Compact persistent header: status + Next-PLI on the left,
         Start/Stop on the right. One slim block instead of four rows so
         the tab content below gets the vertical space. Hidden while the
         full-panel Decodes page is open. -->
    <LinearLayout
        android:id="@+id/hbc_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hbc_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_stopped"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hbc_pli_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_pli_countdown_idle"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/hbc_start_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:text="@string/hbc_start" />
    </LinearLayout>

    <!-- Slim tab bar (hidden while the Decodes page is open) -->
    <LinearLayout
        android:id="@+id/hbc_tabbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/hbc_tab_btn_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="12sp"
            android:text="@string/hbc_tab_audio" />

        <Button
            android:id="@+id/hbc_tab_btn_options"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="12sp"
            android:text="@string/hbc_tab_options" />

        <Button
            android:id="@+id/hbc_tab_btn_decodes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="12sp"
            android:text="@string/hbc_tab_decodes" />
    </LinearLayout>

    <!-- ============== AUDIO SETUP TAB ============== -->
    <ScrollView
        android:id="@+id/hbc_tab_audio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_modem_label" />

            <com.atakmap.android.gui.PluginSpinner
                android:id="@+id/hbc_modem_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_stream_label" />

            <com.atakmap.android.gui.PluginSpinner
                android:id="@+id/hbc_tx_stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_tx_output_label" />

            <com.atakmap.android.gui.PluginSpinner
                android:id="@+id/hbc_tx_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_afsk_level_label" />

            <EditText
                android:id="@+id/hbc_afsk_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:text="@string/hbc_afsk_level_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hbc_dwell_label" />

                    <EditText
                        android:id="@+id/hbc_dwell"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/hbc_dwell_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hbc_vox_label" />

                    <EditText
                        android:id="@+id/hbc_vox_leader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/hbc_vox_default" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hbc_mac_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hbc_mac_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hbc_mac_help_link"
                    android:textColor="#4FC3F7"
                    android:textSize="12sp"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <com.atakmap.android.gui.PluginSpinner
                android:id="@+id/hbc_mac_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hbc_ring_guard_label" />

                    <EditText
                        android:id="@+id/hbc_ring_guard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/hbc_ring_guard_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hbc_ring_skip_label" />

                    <EditText
                        android:id="@+id/hbc_ring_skip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/hbc_ring_skip_default" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hbc_ring_maxturn_label" />

                    <EditText
                        android:id="@+id/hbc_ring_maxturn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/hbc_ring_maxturn_default" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============== OPTIONS TAB ============== -->
    <ScrollView
        android:id="@+id/hbc_tab_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_callsign_label" />

            <EditText
                android:id="@+id/hbc_callsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hbc_callsign_hint"
                android:inputType="textCapCharacters"
                android:maxLength="8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_send_to_label" />

            <com.atakmap.android.gui.PluginSpinner
                android:id="@+id/hbc_send_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_pli_rate_label" />

            <EditText
                android:id="@+id/hbc_pli_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="@string/hbc_pli_rate_default" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_txrx_label"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/hbc_tx_enable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_tx_enable" />

                <CheckBox
                    android:id="@+id/hbc_rx_enable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_rx_enable" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_modes_label"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/hbc_mode_pli"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_pli" />

                <CheckBox
                    android:id="@+id/hbc_mode_spots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_spots" />

                <CheckBox
                    android:id="@+id/hbc_mode_alerts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_alerts" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/hbc_mode_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_chat" />

                <CheckBox
                    android:id="@+id/hbc_mode_shapes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_shapes" />

                <CheckBox
                    android:id="@+id/hbc_mode_casevac"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hbc_mode_casevac" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbc_bridge_label"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/hbc_c2_bridge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="false"
                    android:text="@string/hbc_c2_bridge" />

                <Button
                    android:id="@+id/hbc_push_rf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textSize="12sp"
                    android:text="@string/hbc_push_rf" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============== DECODES TAB ============== -->
    <LinearLayout
        android:id="@+id/hbc_tab_decodes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Page header: Back (restores the settings tabs) + title + Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/hbc_decodes_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:text="@string/hbc_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="8dp"
                android:text="@string/hbc_decodes_title"
                android:textStyle="bold"
                android:textSize="16sp" />

            <Button
                android:id="@+id/hbc_decodes_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:text="@string/hbc_decodes_clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/hbc_decodes_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hbc_decodes_none"
            android:paddingBottom="4dp" />

        <ScrollView
            android:id="@+id/hbc_decodes_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/hbc_decodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:typeface="monospace" />
        </ScrollView>

        <!-- Area 2: detailed live activity log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hbc_log_label"
            android:textStyle="bold"
            android:paddingTop="6dp" />

        <TextView
            android:id="@+id/hbc_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>
</LinearLayout>
