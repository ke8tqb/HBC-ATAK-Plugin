## ============================================================
## local.properties.example
## Copy this file to local.properties and fill in your paths.
## local.properties is git-ignored and never committed.
## ============================================================

## REQUIRED — Android SDK location
## In Android Studio: File > Project Structure > SDK Location
sdk.dir=C\:/Users/YourName/AppData/Local/Android/Sdk

## ============================================================
## ATAK SDK — Option A (recommended offline)
## Download the ATAK-CIV SDK (version 5.6.0) from https://tak.gov
## (free account required). Unzip it; it contains:
##   main.jar                 (ATAK API)
##   atak-gradle-takdev.jar   (Gradle plugin that auto-generates the debug keystore)
## ============================================================

## Point to the atak-gradle-takdev.jar from the unzipped SDK:
takdev.plugin=C\:/path/to/ATAK-CIV-5.7.0.15-SDK/atak-gradle-takdev.jar

## Point to the unzipped SDK folder itself. This switches takdev into its
## Offline DevKit mode, where main.jar, the debug keystore, mapping.txt and
## the core proguard rules all come from the SDK (no TAK maven repo needed):
sdk.path=C\:/path/to/ATAK-CIV-5.7.0.15-SDK

## The ATAK line to target (stamps the plugin-api string; one APK per line).
## Can also be passed per build:  gradlew -PATAK_VERSION=5.8.0 assembleCivDebug
# ATAK_VERSION=5.7.0

## NOTE: For DEBUG builds, NO signing keys are needed in local.properties.
## The atak-gradle-takdev Gradle plugin automatically generates a debug
## keystore at build/android_keystore (password: tnttnt, alias: wintec_mapping).
## You only need the release keys below if you are making a release/production build.

## Release signing (optional — only for production builds):
# takReleaseKeyFile=C\:/path/to/release.keystore
# takReleaseKeyFilePassword=YOUR_STORE_PASSWORD
# takReleaseKeyAlias=YOUR_KEY_ALIAS
# takReleaseKeyPassword=YOUR_KEY_PASSWORD

## ============================================================
## ATAK SDK — Option B (TAK Maven repository credentials)
## If you have a TAK.gov developer account with Artifactory access:
## ============================================================
# takrepo.url=https://artifacts.tak.gov/artifactory/maven
# takrepo.user=YOUR_USERNAME
# takrepo.password=YOUR_PASSWORD
