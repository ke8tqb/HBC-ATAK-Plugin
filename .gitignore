# Build outputs
.gradle/
build/
app/build/
*.apk
*.aab

# NDK / CMake cached deps (re-fetched at configure time)
app/src/main/cpp/deps/
.cxx/

# takdev staging area (the takdev gradle plugin re-extracts its lint AAR
# here from its own jar on every build)
.takdev/

# Local config — never commit this!
local.properties

# Android Studio
*.iml
.idea/
.idea/workspace.xml

# macOS
.DS_Store

# Windows
Thumbs.db

# ATAK SDKs (large — not committed; build-both.ps1 caches extracted SDKs
# under %LOCALAPPDATA%\ATAK-SDKs)
ATAK-CIV-*-SDK/
ATAK-CIV-*-SDK.zip
sdk/


# allow the checked-in prebuilt plugin APK
!prebuilt/*.apk
